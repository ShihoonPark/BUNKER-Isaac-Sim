{
  "schema_version": 1,
  "metadata": {
    "description": "Stage E nominal Isaac closed loop for the real GLIM classroom route, maneuver-aware reference, Direction-Aware Controller V2, and canonical directional-force plant.",
    "calibration_warning": "Integration validation only. No simulator-real equivalence or BUNKER calibration is claimed."
  },
  "baseline_configs": {
    "map_route_reference": "config/map_route_reference_v1.json",
    "direction_aware_controller": "config/tracking_controller_v2_direction_aware.json",
    "tracked_force_plant_v2": "config/tracked_force_plant_v2.json"
  },
  "comparison": {
    "kinematic_v2_summary": "logs/map_route_kinematic_validation_v2/summary.json",
    "kinematic_scenario": "map_nominal"
  },
  "runtime": {
    "support_mode_required": "flat_track_boxes",
    "creation_order": "normal",
    "scheduler_time_tolerance_s": 1e-12,
    "active_window_time_tolerance_s": 1e-12,
    "saturation_scale_tolerance": 1e-12,
    "custom_force_normal_tolerance_n": 1e-7,
    "local_initial_pose_tolerance": 1e-9,
    "ordered_projection_half_window_segments": 60,
    "detailed_contacts": false,
    "force_guard_near_fraction": 0.99,
    "actuator_ceiling_tolerance_m_s": 1e-9
  },
  "output": {
    "default_directory": "logs/map_route_isaac_closed_loop_v1",
    "stage_filename": "map_route_isaac_closed_loop_v1.usd",
    "csv_filename": "nominal.csv",
    "summary_filename": "summary.json",
    "plot_filename": "map_route_isaac_closed_loop_v1.png"
  }
}
