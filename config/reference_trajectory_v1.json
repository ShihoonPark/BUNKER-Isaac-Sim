{
  "metadata": {
    "schema_version": 1,
    "description": "Reference Trajectory V1 for the BUNKER MINI analytic validation path.",
    "calibration_status": "All trajectory limits and numerical settings are initial simulation assumptions, not real-robot calibrated values."
  },
  "measured_fixed": {
    "source": "Measured from the actual BUNKER MINI STL geometry",
    "track_center_distance_m": 0.434
  },
  "path": {
    "start_pose": {"x_m": 0.0, "y_m": 0.0, "yaw_rad": 0.0},
    "segments": [
      {"type": "line", "length_m": 2.0},
      {"type": "arc", "radius_m": 0.75, "angle_deg": 90.0},
      {"type": "line", "length_m": 1.5},
      {"type": "arc", "radius_m": 0.55, "angle_deg": -90.0},
      {"type": "line", "length_m": 2.0}
    ],
    "dense_sampling_step_m": 0.005,
    "resampling_interval_m": 0.020,
    "duplicate_distance_tolerance_m": 1e-10,
    "curvature_validation_boundary_margin_m": 0.08,
    "curvature_near_zero_epsilon_1_m": 1e-9
  },
  "trajectory_limits": {
    "status": "Initial uncalibrated trajectory assumptions; not measured BUNKER limits",
    "maximum_body_speed_m_s": 0.60,
    "start_speed_m_s": 0.0,
    "end_speed_m_s": 0.0,
    "maximum_acceleration_m_s2": 0.35,
    "maximum_deceleration_m_s2": 0.45,
    "maximum_lateral_acceleration_m_s2": 0.25,
    "maximum_yaw_rate_rad_s": 0.70,
    "maximum_track_surface_speed_m_s": 0.80,
    "limit_tie_tolerance_m_s": 1e-10,
    "limit_reason_priority": ["global", "curvature", "yaw_rate", "track_speed"],
    "phase_acceleration_tolerance_m_s2": 1e-5,
    "phase_speed_tolerance_m_s": 1e-6
  },
  "validation": {
    "resampling_tolerance_m": 1e-8,
    "numeric_curvature_interior_max_error_1_m": 0.03,
    "numeric_curvature_interior_rms_error_1_m": 0.01,
    "constraint_tolerance": 1e-9
  },
  "output": {
    "default_directory": "logs/reference_trajectory_v1",
    "plot_filename": "reference_trajectory_v1.png"
  }
}
